---
// animated 時播放 Google Noto Animated Emoji（CC BY 4.0）的 Lottie 動畫；
// 這個 emoji 沒有動畫、載入失敗或使用者偏好減少動態時，就顯示一般的 emoji
interface Props {
  char: string;
  animated?: boolean;
}

const { char, animated = false } = Astro.props;
const codepoints = [...char]
  .map((c) => c.codePointAt(0)!.toString(16))
  .filter((cp) => cp !== 'fe0f')
  .join('_');
---

{
  animated ? (
    <span class="emoji noto" data-noto={codepoints} aria-hidden="true">
      <span class="still">{char}</span>
    </span>
  ) : (
    <span class="emoji" aria-hidden="true">
      {char}
    </span>
  )
}

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function play(el: HTMLElement) {
    try {
      const res = await fetch(`https://fonts.gstatic.com/s/e/notoemoji/latest/${el.dataset.noto}/lottie.json`);
      if (!res.ok) return;
      const animationData = await res.json();
      const box = document.createElement('span');
      box.className = 'player';
      el.append(box);
      // 播放器只在頁面上真的有動態 emoji 時才載入
      const { default: lottie } = await import('lottie-web/build/player/lottie_light');
      lottie.loadAnimation({ container: box, renderer: 'svg', loop: true, autoplay: true, animationData });
      el.classList.add('playing');
    } catch {
      // 留著一般的 emoji
    }
  }

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-noto]').forEach(play);
  }
</script>

<style>
  .noto {
    position: relative;
    width: 1.15em;
    height: 1.15em;
    /* 和標題文字垂直置中：middle 會偏低一點，再往上拉 0.1em */
    vertical-align: middle;
    top: -0.1em;
    text-align: center;
  }
  .noto :global(.player) {
    position: absolute;
    inset: 0;
  }
  .noto.playing .still {
    visibility: hidden;
  }
</style>
